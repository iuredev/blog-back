{
  "kind": "collectionType",
  "collectionName": "projects",
  "info": {
    "singularName": "project",
    "pluralName": "projects",
    "displayName": "Project",
    "description": "Personal and professional projects"
  },
  "options": {
    "draftAndPublish": true
  },
  "attributes": {
    "title": {
      "type": "string",
      "required": true
    },
    "slug": {
      "type": "uid",
      "targetField": "title"
    },
    "description": {
      "type": "text",
      "required": true
    },
    "link": {
      "type": "string"
    },
    "repository": {
      "type": "string"
    },
    "role": {
      "type": "string"
    },
    "year": {
      "type": "integer",
      "min": 2000,
      "max": 2100
    },
    "technologies": {
      "type": "json"
    },
    "status": {
      "type": "enumeration",
      "enum": ["active", "completed", "archived", "concept"]
    },
    "content": {
      "type": "richtext"
    },
    "featured": {
      "type": "boolean",
      "default": false
    },
    "featuredOrder": {
      "type": "integer",
      "min": 0
    },
    "cover": {
      "type": "media",
      "multiple": false,
      "required": false,
      "allowedTypes": ["images"]
    }
  }
}
